<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ 原创拟态（Neo Neumorphism）夜间色板 ============
         夜间基面取深雾蓝，阴影转纯黑、高光转浅蓝灰，主色/辅色/强调保持亮色。
         层次仍由双向光照（左上高光 / 右下阴影）塑造，与浅色版一一对应。 -->

    <!-- 基色 / 光照 -->
    <color name="neo_base">#0D1320</color>
    <color name="neo_card">#161E2D</color>
    <color name="neo_card_edge">#2A3A55</color>
    <color name="neo_highlight">#232E41</color>
    <color name="neo_bubble_ai">#1B2333</color>

    <!-- 阴影（夜间更暗） -->
    <color name="neo_shadow">#04070C</color>
    <color name="neo_shadow_deep">#000000</color>

    <!-- 凹陷面 -->
    <color name="neo_pressed">#101725</color>
    <color name="neo_pressed_edge">#0A0F18</color>

    <!-- 主色：对齐截图蓝色系（夜间提亮保证对比度） -->
    <color name="neo_primary">#5B8DFF</color>
    <color name="neo_primary_deep">#3D6FE8</color>
    <color name="neo_primary_soft">#122240</color>

    <!-- 辅色：电光紫 -->
    <color name="neo_secondary">#9D8FFF</color>
    <color name="neo_secondary_soft">#221D3C</color>

    <!-- 强调：琥珀橙 -->
    <color name="neo_accent">#FFB454</color>
    <color name="neo_accent_soft">#332A10</color>

    <!-- 文字（浅色高对比） -->
    <color name="neo_text_primary">#E6EDF5</color>
    <color name="neo_text_secondary">#A6B3C4</color>
    <color name="neo_text_hint">#6E7E93</color>
    <color name="neo_on_primary">#FFFFFF</color>

    <!-- 危险 -->
    <color name="neo_error">#E5484D</color>

    <!-- 蓝色强调：能量统计列标题 / 底部导航选中态（夜间提亮保证对比度） -->
    <color name="neo_blue">#5B8DFF</color>

    <!-- 悬浮胶囊底栏：深雾蓝半透明毛玻璃 + 描边 -->
    <color name="neo_nav_float_bg">#CC161E2D</color>
    <color name="neo_nav_float_edge">#2A3A55</color>

    <!-- 导航选中项高亮块：半透明蓝灰 + 淡蓝描边 -->
    <color name="neo_nav_item_selected">#332A3A55</color>
    <color name="neo_nav_item_selected_edge">#556B8DFF</color>

    <!-- 拟态光影：夜间软影转深、高光转浅蓝灰 -->
    <color name="neo_shadow_soft">#66070C14</color>
    <color name="neo_shadow_outer">#33070C14</color>
    <color name="neo_highlight_soft">#3DFFFFFF</color>

    <!-- 功能页分类图标渐变（夜间提亮，保持蓝色系对齐） -->
    <color name="neo_feat_base_start">#5B8DFF</color>
    <color name="neo_feat_base_end">#3D6FF0</color>
    <color name="neo_feat_forest_start">#4FDDEE</color>
    <color name="neo_feat_forest_end">#1FB2D4</color>
    <color name="neo_feat_farm_start">#7A95FF</color>
    <color name="neo_feat_farm_end">#4F6AF5</color>
    <color name="neo_feat_village_start">#6FC9FB</color>
    <color name="neo_feat_village_end">#3FA1F5</color>
    <color name="neo_feat_sport_start">#97A6FF</color>
    <color name="neo_feat_sport_end">#6D7CF5</color>
    <color name="neo_feat_other_start">#AAB8CC</color>
    <color name="neo_feat_other_end">#8495AE</color>
</resources>
